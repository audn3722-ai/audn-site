---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import PersonCard from '../../../components/PersonCard.astro';
import { getCollection } from 'astro:content';
import { t, programs, langs, type Lang } from '../../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const all = (await getCollection('teachers')).sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
const groups = [
  ...programs.map((p) => ({ key: p.slug, title: `${p[lang].title} (${p.code})` })),
  { key: 'common', title: d.common },
].map((g) => ({ ...g, people: all.filter((x) => x.data.program === g.key) })).filter((g) => g.people.length);
---
<Base lang={lang} title={d.nav.teachers} path="/education/teachers/">
  <PageHead lang={lang} title={d.nav.teachers} path="/education/teachers/" />
  <section>
    <div class="wrap">
      {groups.length === 0 ? <p class="lead">{d.noTeachers}</p> : groups.map((g) => (
        <div class="grp">
          <h2>{g.title}</h2>
          <div class="grid g2">
            {g.people.map((p) => (
              <PersonCard name={p.data.name} role={(lang === 'kg' && p.data.role_kg) || p.data.role_ru} photo={p.data.photo}
                extra={(lang === 'kg' && p.data.disciplines_kg) || p.data.disciplines_ru} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>.grp + .grp { margin-top: 44px; } h2 { font-size: 24px; }</style>
