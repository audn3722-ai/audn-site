---
import { t, url, otherLang, menu, info, type Lang } from '../i18n';
interface Props { lang: Lang; title?: string; path: string; description?: string }
const { lang, title, path, description } = Astro.props;
const d = t[lang];
const pageTitle = title ? `${title} — ${d.short}` : `${d.name} — ${d.short}`;
const current = path.replace(/^\//, '');
const isActive = (m: (typeof menu)[number]) =>
  [m.path, ...(m.children ?? []).map((c) => c.path)].some((p) => current.startsWith(p.split('/')[0] + '/'));
const ol = otherLang(lang);
const desc = description ?? d.fullName;
const canonical = new URL(url(`/${lang}/${current}`), Astro.site).href;
---
<!doctype html>
<html lang={lang === 'kg' ? 'ky' : 'ru'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#0b1f4b" />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon.png')} />
  <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
  <link rel="alternate" hreflang="ru" href={new URL(url(`/ru/${current}`), Astro.site).href} />
  <link rel="alternate" hreflang="ky" href={new URL(url(`/kg/${current}`), Astro.site).href} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={d.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(url('/og.jpg'), Astro.site).href} />
  <meta property="og:locale" content={lang === 'kg' ? 'ky_KG' : 'ru_RU'} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Inter:wght@400;500;600&display=swap&subset=cyrillic,cyrillic-ext" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#main">{d.skip}</a>
  <nav class="utility" aria-label={d.quickNav}>
    <div class="wrap ub">
      <span class="ub-name">{d.name}</span>
      <div class="ub-actions">
        <a href={url(`/${lang}/admission/`)}>{d.applyNow}</a>
        <a href={url(`/${lang}/contacts/`)}>{d.requestInfo}</a>
        <a class="ub-lang" href={url(`/${ol}/${current}`)} hreflang={ol === 'kg' ? 'ky' : 'ru'} lang={ol === 'kg' ? 'ky' : 'ru'}>{ol === 'kg' ? 'Кыргызча' : 'Русский'}</a>
      </div>
    </div>
  </nav>
  <header class="site-header">
    <div class="wrap bar">
      <a class="brand" href={url(`/${lang}/`)} aria-label={`${d.name} — ${d.nav.home}`}>
        <img src={url('/img/emblem-sm.webp')} alt="" width="52" height="43" />
        <b>{d.short}</b>
      </a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="site-nav" aria-label={d.menu}><span></span></button>
      <nav class="nav" id="site-nav" aria-label={d.mainNav}>
        {menu.map((m) => m.children ? (
          <div class={`dd ${isActive(m) ? 'active' : ''}`}>
            <a class="top" href={url(`/${lang}/${m.path}`)} aria-current={isActive(m) ? 'true' : undefined}>{d.nav[m.key]}<i aria-hidden="true"></i></a>
            <div class="sub">
              {m.children.map((c) => <a href={url(`/${lang}/${c.path}`)} class={current === c.path ? 'cur' : ''} aria-current={current === c.path ? 'page' : undefined}>{d.nav[c.key]}</a>)}
            </div>
          </div>
        ) : (
          <a class={`top ${isActive(m) ? 'active' : ''}`} href={url(`/${lang}/${m.path}`)} aria-current={isActive(m) ? 'page' : undefined}>{d.nav[m.key]}</a>
        ))}
        <a class="lang" href={url(`/${ol}/${current}`)} hreflang={ol === 'kg' ? 'ky' : 'ru'} lang={ol === 'kg' ? 'ky' : 'ru'} aria-label={ol === 'kg' ? 'Кыргызча' : 'Русский'}>{ol === 'kg' ? 'KG' : 'RU'}</a>
      </nav>
    </div>
  </header>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="site-footer">
    <div class="wrap fgrid">
      <div class="fbrand">
        <img src={url('/img/emblem-white.png')} alt="" width="76" height="63" />
        <p class="fname">{d.name}</p>
        <p>{d.address}</p>
        <div class="fbtns">
          <a class="btn btn-red" href={url(`/${lang}/admission/`)}>{d.applyNow}</a>
        </div>
      </div>
      <nav class="fcol" aria-label={d.footNav}>
        <h2>{d.footUni}</h2>
        {menu[0].children!.map((c) => <a href={url(`/${lang}/${c.path}`)}>{d.nav[c.key]}</a>)}
        <a href={url(`/${lang}/news/`)}>{d.nav.news}</a>
      </nav>
      <div class="fcol">
        <h2>{d.footStudy}</h2>
        {[...menu[1].children!, ...menu[2].children!].map((c) => <a href={url(`/${lang}/${c.path}`)}>{d.nav[c.key]}</a>)}
      </div>
      <div class="fcol">
        <h2>{d.footStudents}</h2>
        {menu[3].children!.map((c) => <a href={url(`/${lang}/${c.path}`)}>{d.nav[c.key]}</a>)}
        <h2 class="mt">{d.footContacts}</h2>
        <p>{d.phone}: {info.phone ? <a href={`tel:${info.phone.replace(/\s/g, '')}`}>{info.phone}</a> : d.tbd}</p>
        <p>{d.email}: {info.email ? <a href={`mailto:${info.email}`}>{info.email}</a> : d.tbd}</p>
      </div>
    </div>
    <div class="wrap copy">
      <span>© {new Date().getFullYear()} {d.name}. {d.rights}.</span>
      <a href={url(`/${ol}/${current}`)} lang={ol === 'kg' ? 'ky' : 'ru'}>{ol === 'kg' ? 'Кыргызча' : 'Русский'}</a>
    </div>
  </footer>
  <script>
    const btn = document.querySelector<HTMLButtonElement>('.burger');
    const nav = document.getElementById('site-nav');
    const setOpen = (o: boolean) => { btn?.setAttribute('aria-expanded', String(o)); nav?.classList.toggle('open', o); document.body.classList.toggle('menu-open', o); };
    btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav?.classList.contains('open')) { setOpen(false); btn?.focus(); } });
    window.matchMedia('(min-width: 1101px)').addEventListener('change', (m) => m.matches && setOpen(false));
  </script>
</body>
</html>

<style is:global>
  :root {
    --navy: #0b1f4b; --navy-2: #13306b; --red: #b3121a; --ink: #1a2233; --muted: #5b6478;
    --bg: #f6f7fb; --card: #fff; --line: #e3e7f0; --radius: 14px;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 96px; -webkit-text-size-adjust: 100%; }
  a, button, summary { touch-action: manipulation; }
  :focus-visible { outline: 3px solid var(--red); outline-offset: 3px; border-radius: 6px; }
  .page-head :focus-visible, .hero :focus-visible, .cta :focus-visible, .site-footer :focus-visible { outline-color: #fff; }
  main:focus { outline: none; }
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--navy); color: #fff; padding: 12px 18px; border-radius: 8px; font-weight: 600; text-decoration: none; transition: top .15s; }
  .skip:focus { top: 12px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; } }
  body { margin: 0; font: 400 17px/1.65 Inter, system-ui, sans-serif; color: var(--ink); background: var(--bg); }
  h1, h2, h3 { font-family: Montserrat, Inter, sans-serif; color: var(--navy); line-height: 1.2; margin: 0 0 .6em; }
  h1 { font-size: clamp(30px, 4.6vw, 52px); font-weight: 800; }
  h2 { font-size: clamp(24px, 3vw, 34px); font-weight: 700; }
  h3 { font-size: 20px; font-weight: 700; }
  a { color: var(--navy-2); }
  img { max-width: 100%; height: auto; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 22px; }
  section { padding: 72px 0; }
  .eyebrow { display: inline-flex; align-items: center; gap: 10px; font: 600 13px/1 Montserrat, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }
  .eyebrow::before { content: ''; width: 28px; height: 2px; background: var(--red); }
  .lead { font-size: 19px; color: var(--muted); max-width: 720px; }
  .btn { display: inline-block; padding: 13px 26px; border-radius: 999px; font: 600 15px/1 Montserrat, sans-serif; text-decoration: none; transition: .2s; }
  .btn-red { background: var(--red); color: #fff; }
  .btn-red:hover { background: #8f0e15; }
  .btn-ghost { border: 2px solid currentColor; color: #fff; }
  .btn-ghost:hover { background: #fff; color: var(--navy); }
  .btn-outline { border: 2px solid var(--navy); color: var(--navy); }
  .btn-outline:hover { background: var(--navy); color: #fff; }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .grid { display: grid; gap: 22px; }
  .g2 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr)); }
  .g3 { grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); }
  .page-head { background: linear-gradient(135deg, var(--navy), var(--navy-2)); color: #fff; padding: 64px 0 56px; }
  .page-head h1 { color: #fff; margin: 0; }
  .page-head .eyebrow { color: #ff8a8f; } .page-head .eyebrow::before { background: #ff8a8f; }
  .prose { max-width: 780px; } .prose p { margin: 0 0 1em; }
  .tag { display: inline-block; font: 600 13px/1 Montserrat, sans-serif; color: var(--red); background: #fbe9ea; padding: 6px 10px; border-radius: 6px; }

  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.96); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 74px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand b { font: 800 21px Montserrat, sans-serif; color: var(--navy); letter-spacing: .04em; }
  .nav { display: flex; align-items: center; gap: 4px; }
  .nav a { white-space: nowrap; padding: 8px 10px; border-radius: 8px; text-decoration: none; color: var(--ink); font-weight: 500; font-size: 15.5px; }
  .nav a:hover, .nav a.active, .dd.active > .top { color: var(--red); }
  .dd { position: relative; }
  .dd .top i { display: inline-block; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); margin: 0 0 3px 7px; }
  .sub { position: absolute; top: 100%; left: 0; min-width: 230px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 16px 34px rgba(11,31,75,.12); padding: 8px; display: none; }
  .dd:hover .sub, .dd:focus-within .sub { display: block; }
  .sub a { display: block; padding: 9px 12px; font-size: 15px; }
  .sub a:hover, .sub a.cur { background: var(--bg); color: var(--red); }
  .nav a.lang { display: none; margin-left: 8px; border: 1.5px solid var(--navy); color: var(--navy); font: 700 13px/1 Montserrat, sans-serif; padding: 8px 11px; }
  .nav a.lang:hover { background: var(--navy); color: #fff; }
  .burger { display: none; }
  @media (max-width: 1100px) {
    .burger { display: block; width: 44px; height: 44px; position: relative; cursor: pointer; background: none; border: 0; border-radius: 10px; margin-right: -6px; }
    .burger span, .burger span::before, .burger span::after { position: absolute; left: 10px; width: 24px; height: 2px; background: var(--navy); content: ''; transition: transform .2s, opacity .2s; }
    .burger span { top: 21px; } .burger span::before { top: -7px; left: 0; } .burger span::after { top: 7px; left: 0; }
    .burger[aria-expanded="true"] span { background: transparent; }
    .burger[aria-expanded="true"] span::before { transform: translateY(7px) rotate(45deg); }
    .burger[aria-expanded="true"] span::after { transform: translateY(-7px) rotate(-45deg); }
    .nav { position: absolute; top: 74px; box-shadow: 0 18px 30px rgba(11,31,75,.12); left: 0; right: 0; flex-direction: column; align-items: stretch; background: #fff; border-bottom: 1px solid var(--line); padding: 10px 22px 18px; display: none; max-height: calc(100dvh - 74px); overflow-y: auto; }
    .sub { position: static; display: block; border: 0; box-shadow: none; padding: 0 0 6px 14px; min-width: 0; }
    .dd .top i { display: none; } .dd .top { font-weight: 600; }
    .nav.open { display: flex; }
    .nav a { padding: 12px 10px; }
    body.menu-open { overflow: hidden; }
    .nav a.lang { display: block; margin: 8px 0 0; text-align: center; padding: 14px; }
  }

  .site-footer { background: var(--navy); color: #c9d2e6; padding: 64px 0 24px; font-size: 15px; }
  .fgrid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; }
  @media (max-width: 900px) { .fgrid { grid-template-columns: 1fr 1fr; } .fbrand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .fgrid { grid-template-columns: 1fr; } }
  .fname { font: 700 18px/1.3 Montserrat, sans-serif; color: #fff; margin: 16px 0 8px; }
  .fbrand p { margin: 0 0 8px; max-width: 360px; }
  .fbtns { margin-top: 18px; }
  .fcol { display: flex; flex-direction: column; gap: 4px; }
  .fcol h2 { font: 700 13px Montserrat, sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #fff; margin: 0 0 10px; }
  .fcol h2.mt { margin-top: 22px; }
  .fcol a { color: #c9d2e6; text-decoration: none; padding: 5px 0; }
  .fcol a:hover { color: #fff; text-decoration: underline; }
  .fcol p { margin: 4px 0; } .fcol p a { color: #fff; }
  .copy { border-top: 1px solid rgba(255,255,255,.14); margin-top: 44px; padding-top: 20px; font-size: 13.5px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .copy a { color: #fff; }

  .utility { background: var(--navy); color: #c9d2e6; font-size: 13.5px; }
  .ub { display: flex; justify-content: space-between; align-items: center; min-height: 40px; gap: 16px; }
  .ub-actions { display: flex; gap: 6px; }
  .ub-actions a { color: #fff; text-decoration: none; font-weight: 600; padding: 9px 12px; }
  .ub-actions a:hover { text-decoration: underline; }
  .ub-actions a:first-child { background: var(--red); border-radius: 0; }
  .ub-actions a:first-child:hover { background: #8f0e15; text-decoration: none; }
  .ub-lang { border-left: 1px solid rgba(255,255,255,.2); }
  .utility :focus-visible { outline-color: #fff; }
  @media (max-width: 760px) { .ub-name { display: none; } .ub { justify-content: flex-end; } .ub-actions a { padding: 9px 8px; } }
  @media (max-width: 400px) { .ub-actions a:nth-child(2) { display: none; } .ub { padding-inline: 12px; } .ub-actions a { font-size: 12.5px; padding: 9px 8px; } }
</style>
