---
import { getCollection } from 'astro:content';
import { t, fileUrl, type Lang } from '../i18n';
interface Props { lang: Lang; categories: string[]; empty?: boolean }
const { lang, categories } = Astro.props;
const d = t[lang];
const docs = (await getCollection('documents', (x) => categories.includes(x.data.category)))
  .sort((a, b) => a.data.order - b.data.order || +(b.data.date ?? 0) - +(a.data.date ?? 0));
---
{docs.length === 0 ? <p class="empty">{d.noDocs}</p> : (
  <ul class="docs">
    {docs.map((x) => {
      const href = fileUrl(x.data.file) || x.data.link || '#';
      const title = (lang === 'kg' && x.data.title_kg) || x.data.title_ru;
      const ext = (x.data.file ?? '').split('.').pop()?.toUpperCase();
      return (
        <li><a href={href} target="_blank" rel="noopener">
          <span class="ic">{x.data.file ? ext : '↗'}</span>
          <span class="tt">{title}</span>
          <span class="go">{d.download} →</span>
        </a></li>
      );
    })}
  </ul>
)}
<style>
  .docs { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .docs a { display: flex; align-items: center; gap: 16px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 18px; text-decoration: none; color: var(--ink); transition: .2s; }
  .docs a:hover { border-color: var(--navy); box-shadow: 0 8px 20px rgba(0,0,0,.06); }
  .ic { flex: none; width: 46px; height: 46px; border-radius: var(--radius); background: var(--gold-soft); color: var(--red); display: grid; place-items: center; font: 500 12px var(--cond); letter-spacing: .08em; }
  .tt { flex: 1; font-weight: 500; }
  .go { color: var(--red); font-weight: 600; font-size: 14px; white-space: nowrap; }
  .empty { color: var(--muted); }
</style>
