---
import Base from '../../layouts/Base.astro';
import { t, info, langs, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const map = 'https://www.openstreetmap.org/export/embed.html?bbox=72.96%2C40.91%2C73.03%2C40.95&layer=mapnik';
---
<Base lang={lang} title={d.nav.contacts} path="/contacts/">
  <div class="page-head"><div class="wrap"><div class="eyebrow">{d.short}</div><h1>{d.nav.contacts}</h1></div></div>
  <section>
    <div class="wrap grid g2">
      <div class="card list">
        <div><span>{d.addressLabel}</span><p>{d.address}</p></div>
        <div><span>{d.phone}</span><p>{info.phone ? <a href={`tel:${info.phone.replace(/\s/g, '')}`}>{info.phone}</a> : d.tbd}</p></div>
        <div><span>{d.email}</span><p>{info.email ? <a href={`mailto:${info.email}`}>{info.email}</a> : d.tbd}</p></div>
        <div><span>{d.rector}</span><p>{info.rector[lang]}</p></div>
      </div>
      <iframe class="map" src={map} title="map" loading="lazy"></iframe>
    </div>
  </section>
</Base>
<style>
  .list { display: grid; gap: 20px; }
  .list span { font: 600 12.5px Montserrat, sans-serif; letter-spacing: .1em; text-transform: uppercase; color: var(--red); }
  .list p { margin: 4px 0 0; font-size: 18px; }
  .map { width: 100%; min-height: 380px; border: 1px solid var(--line); border-radius: var(--radius); }
</style>
