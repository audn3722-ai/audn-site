---
import { fileUrl } from '../i18n';
interface Props { name: string; role: string; photo?: string | null; extra?: string | null; level?: 2 | 3 }
const { name, role, photo, extra, level = 3 } = Astro.props;
const H = level === 2 ? 'h2' : 'h3';
const initials = name.split(/\s+/).slice(0, 2).map((w) => w[0]).join('');
---
<div class="person">
  {photo ? <img src={fileUrl(photo)} alt={name} loading="lazy" /> : <div class="ph" aria-hidden="true">{initials}</div>}
  <div>
    <span class="role">{role}</span>
    <H class="nm">{name}</H>
    {extra && <p>{extra}</p>}
  </div>
</div>
<style>
  .person { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; display: flex; gap: 18px; align-items: center; }
  img, .ph { width: 86px; height: 86px; border-radius: 50%; object-fit: cover; flex: none; }
  .ph { background: var(--bg-alt); color: var(--navy); display: grid; place-items: center; font: 700 26px var(--serif); }
  .role { font: 500 12.5px var(--cond); letter-spacing: .08em; letter-spacing: .06em; text-transform: uppercase; color: var(--red); }
  .nm { margin: 6px 0 0; font-size: 18px; }
  p { margin: 6px 0 0; color: var(--muted); font-size: 15px; }
</style>
