---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { t, url, programs, fmtDate, langs, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const news = (await getCollection('news', (n) => n.data.lang === lang && !n.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const L = {
  ru: { why: 'Почему АУДН', whyT: 'Университет, где учат практике', dirs: 'Направления подготовки', latest: 'Новости университета',
    feats: [['Практика с первого курса', 'Казусы, учебные процессы, интерактивные игры и стажировки в профильных организациях.'],
            ['Опытные преподаватели', 'Практикующие юристы и педагоги, которые знают, чего ждёт работодатель.'],
            ['Обучение на двух языках', 'Занятия и материалы на русском и кыргызском языках.']],
    ctaT: 'Приёмная кампания', ctaP: 'Узнайте о порядке поступления, документах и сроках подачи.' },
  kg: { why: 'Эмне үчүн АУДН', whyT: 'Практикага үйрөткөн университет', dirs: 'Даярдоо багыттары', latest: 'Университеттин жаңылыктары',
    feats: [['Биринчи курстан практика', 'Казустар, окуу процесстери, интерактивдүү оюндар жана профилдик уюмдарда стажировка.'],
            ['Тажрыйбалуу окутуучулар', 'Иш берүүчүнүн талабын билген практик юристтер жана педагогдор.'],
            ['Эки тилде окутуу', 'Сабактар жана материалдар орус жана кыргыз тилдеринде.']],
    ctaT: 'Кабыл алуу', ctaP: 'Тапшыруу тартиби, документтер жана мөөнөттөр жөнүндө билиңиз.' },
}[lang];
---
<Base lang={lang} path="/">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">{d.city}</div>
        <h1>{d.name}</h1>
        <p class="lead">{d.tagline}</p>
        <div class="actions">
          <a class="btn btn-red" href={url(`/${lang}/admission/`)}>{d.apply}</a>
          <a class="btn btn-ghost" href={url(`/${lang}/programs/`)}>{d.nav.programs}</a>
        </div>
      </div>
      <div class="hero-art"><img src={url('/img/emblem-white.png')} alt="" width="461" height="381" /></div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">{L.dirs}</div>
      <div class="grid g2">
        {programs.map((p) => (
          <a class="card prog" href={url(`/${lang}/programs/${p.slug}/`)}>
            <span class="tag">{p.code}</span>
            <h3>{p[lang].title}</h3>
            <p>{p[lang].short}</p>
            <span class="more">{d.more} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="alt">
    <div class="wrap">
      <div class="eyebrow">{L.why}</div>
      <h2>{L.whyT}</h2>
      <div class="grid g3 feats">
        {L.feats.map(([h, p], i) => (
          <div class="feat"><span class="num">0{i + 1}</span><h3>{h}</h3><p>{p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="row-head">
        <div><div class="eyebrow">{d.nav.news}</div><h2>{L.latest}</h2></div>
        <a href={url(`/${lang}/news/`)}>{d.allNews} →</a>
      </div>
      {news.length === 0 ? <p class="muted">{d.noNews}</p> : (
        <div class="grid g3">
          {news.map((n) => (
            <a class="card news" href={url(`/${lang}/news/${n.id}/`)}>
              {n.data.image && <img src={n.data.image.startsWith('/') ? url(n.data.image) : n.data.image} alt="" loading="lazy" />}
              <time>{fmtDate(n.data.date, lang)}</time>
              <h3>{n.data.title}</h3>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-in">
      <div><h2>{L.ctaT}</h2><p>{L.ctaP}</p></div>
      <a class="btn btn-red" href={url(`/${lang}/admission/`)}>{d.nav.admission}</a>
    </div>
  </section>
</Base>

<style>
  .hero { background: radial-gradient(circle at 80% 30%, #1d3f86 0, var(--navy) 60%); color: #fff; padding: 96px 0 100px; overflow: hidden; }
  .hero h1 { color: #fff; max-width: 640px; }
  .hero .lead { color: #c9d4ee; }
  .hero .eyebrow { color: #ff8a8f; } .hero .eyebrow::before { background: #ff8a8f; }
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; align-items: center; }
  .hero-art img { opacity: .9; width: 100%; max-width: 420px; display: block; margin-left: auto; }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 28px; }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { display: none; } .hero { padding: 64px 0; } }
  .prog { text-decoration: none; color: inherit; transition: .2s; border-top: 4px solid var(--navy); }
  .prog:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(11,31,75,.1); border-top-color: var(--red); }
  .prog h3 { margin-top: 14px; font-size: 24px; } .prog p { color: var(--muted); }
  .more { font-weight: 600; color: var(--red); }
  .alt { background: #fff; border-block: 1px solid var(--line); }
  .feats { margin-top: 26px; }
  .feat .num { font: 800 36px Montserrat, sans-serif; color: var(--red); opacity: .85; }
  .feat p { color: var(--muted); margin: 0; }
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 18px; }
  .row-head a { font-weight: 600; }
  .muted { color: var(--muted); }
  .news { text-decoration: none; color: inherit; padding: 0; overflow: hidden; }
  .news img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; }
  .news time, .news h3 { display: block; padding: 0 22px; }
  .news time { padding-top: 18px; color: var(--muted); font-size: 14px; } .news h3 { padding-bottom: 22px; margin: 6px 0 0; }
  .cta { background: var(--red); color: #fff; padding: 56px 0; }
  .cta h2 { color: #fff; margin-bottom: .3em; } .cta p { margin: 0; opacity: .9; }
  .cta-in { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .cta .btn-red { background: #fff; color: var(--red); } .cta .btn-red:hover { background: var(--navy); color: #fff; }
</style>
