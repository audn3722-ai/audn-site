---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { t, url, langs, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const P = {
  ru: ['Мы стремимся, чтобы сайт был удобен для всех посетителей, включая людей с нарушениями зрения, слуха и моторики.',
       'Сайт разработан с учётом рекомендаций WCAG 2.2 уровня AA: достаточный контраст текста, навигация с клавиатуры, видимый фокус, подписи для программ экранного доступа, поддержка настройки «уменьшить движение» и масштабирования страницы.',
       'Если вы столкнулись с трудностями при использовании сайта, сообщите нам через страницу контактов — мы постараемся исправить проблему.'],
  kg: ['Сайт бардык колдонуучуларга, анын ичинде көрүү, угуу жана кыймыл мүмкүнчүлүгү чектелген адамдарга ыңгайлуу болушуна аракет кылабыз.',
       'Сайт WCAG 2.2 AA деңгээлинин сунуштарын эске алуу менен иштелип чыккан: тексттин жетиштүү контрасты, клавиатура менен навигация, көрүнүктүү фокус, экран окугучтар үчүн белгилер, «кыймылды азайтуу» жөндөөсүн жана баракты чоңойтууну колдоо.',
       'Эгерде сайтты колдонууда кыйынчылык жаралса, байланыш барагы аркылуу бизге кабарлаңыз — көйгөйдү оңдоого аракет кылабыз.'],
}[lang];
---
<Base lang={lang} title={d.nav.accessibility} path="/accessibility/">
  <PageHead lang={lang} title={d.nav.accessibility} path="/accessibility/" />
  <section>
    <div class="wrap prose">
      {P.map((x) => <p>{x}</p>)}
      <a class="link-arrow" href={url(`/${lang}/contacts/`)}>{d.nav.contacts}</a>
    </div>
  </section>
</Base>
