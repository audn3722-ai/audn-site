---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { t, url, programs, langs, type Lang } from '../../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
---
<Base lang={lang} title={d.nav.programs} path="/programs/">
  <PageHead lang={lang} title={d.nav.programs} path="/programs/" />
  <section>
    <div class="wrap grid g2">
      {programs.map((p) => (
        <a class="card prog" href={url(`/${lang}/programs/${p.slug}/`)}>
          <span class="tag">{p.code}</span>
          <h2>{p[lang].title}</h2>
          <p>{p[lang].short}</p>
          <span class="more">{d.more} →</span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .prog { text-decoration: none; color: inherit; border-top: 4px solid var(--navy); transition: .2s; }
  .prog:hover { border-top-color: var(--red); box-shadow: 0 14px 30px rgba(11,31,75,.1); }
  .prog h2 { margin-top: 14px; } .prog p { color: var(--muted); }
  .more { font-weight: 600; color: var(--red); }
</style>
