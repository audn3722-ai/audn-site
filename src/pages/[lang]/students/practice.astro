---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import DocList from '../../../components/DocList.astro';
import { t, langs, type Lang } from '../../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const intro = { ru: 'Положение о практике, формы дневников и отчётов, сроки прохождения практики.', kg: 'Практика жөнүндө жобо, күндөлүк жана отчёт формалары, практиканы өтөө мөөнөттөрү.' }[lang];
---
<Base lang={lang} title={d.nav.practice} path="/students/practice/">
  <PageHead lang={lang} title={d.nav.practice} path="/students/practice/" />
  <section>
    <div class="wrap">
      <p class="lead">{intro}</p>
      <DocList lang={lang} categories={['practice']} />
    </div>
  </section>
</Base>
<style>.lead { margin-bottom: 28px; }</style>
