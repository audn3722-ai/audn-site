---
import Base from '../../layouts/Base.astro';
import { t, url, info, programs, langs, type Lang } from '../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const L = {
  ru: {
    intro: 'Мы рады абитуриентам, которые хотят стать юристами или педагогами. Ниже — порядок поступления и перечень документов.',
    stepsT: 'Как поступить',
    steps: [['Выберите направление', 'Юриспруденция или Педагогика.'], ['Подготовьте документы', 'Список — ниже на этой странице.'], ['Подайте заявление', 'Лично в приёмной комиссии университета.'], ['Заключите договор', 'И станьте студентом АУДН.']],
    docsT: 'Документы',
    docs: ['Заявление на имя ректора', 'Документ об образовании (аттестат или диплом) — оригинал', 'Сертификат ОРТ (при наличии)', 'Копия паспорта (ID-карты)', 'Фотографии 3×4 — 6 шт.', 'Медицинская справка формы 086-У'],
    note: 'Точные сроки и перечень документов уточняйте в приёмной комиссии.',
    progT: 'Направления',
  },
  kg: {
    intro: 'Юрист же педагог болууну каалаган абитуриенттерди күтөбүз. Төмөндө тапшыруу тартиби жана документтердин тизмеси.',
    stepsT: 'Кантип тапшыруу керек',
    steps: [['Багытты тандаңыз', 'Юриспруденция же Педагогика.'], ['Документтерди даярдаңыз', 'Тизме ушул баракта төмөндө.'], ['Арыз бериңиз', 'Университеттин кабыл алуу комиссиясына жеке өзүңүз.'], ['Келишим түзүңүз', 'Жана АУДНдын студенти болуңуз.']],
    docsT: 'Документтер',
    docs: ['Ректордун атына арыз', 'Билими тууралуу документ (аттестат же диплом) — түп нускасы', 'ЖРТ сертификаты (болсо)', 'Паспорттун (ID-картанын) көчүрмөсү', '3×4 сүрөт — 6 даана', '086-У формасындагы медициналык маалымкат'],
    note: 'Так мөөнөттөрдү жана документтердин тизмесин кабыл алуу комиссиясынан тактаңыз.',
    progT: 'Багыттар',
  },
}[lang];
---
<Base lang={lang} title={d.nav.admission} path="/admission/">
  <div class="page-head"><div class="wrap"><div class="eyebrow">{d.short}</div><h1>{d.nav.admission}</h1></div></div>
  <section>
    <div class="wrap">
      <p class="lead">{L.intro}</p>
      <h2 style="margin-top:40px">{L.stepsT}</h2>
      <ol class="steps">
        {L.steps.map(([h, p]) => <li class="card"><h3>{h}</h3><p>{p}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="alt">
    <div class="wrap two">
      <div>
        <h2>{L.docsT}</h2>
        <ul class="docs">{L.docs.map((x) => <li>{x}</li>)}</ul>
        <p class="note">{L.note}</p>
      </div>
      <div class="card side">
        <h3>{L.progT}</h3>
        {programs.map((p) => <p><span class="tag">{p.code}</span> <a href={url(`/${lang}/programs/${p.slug}/`)}>{p[lang].title}</a></p>)}
        <hr />
        <p><b>{d.addressLabel}:</b> {d.address}</p>
        <p><b>{d.phone}:</b> {info.phone || d.tbd}</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .steps { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); counter-reset: s; }
  .steps li { counter-increment: s; position: relative; padding-top: 58px; }
  .steps li::before { content: counter(s); position: absolute; top: 22px; left: 28px; width: 30px; height: 30px; border-radius: 50%; background: var(--red); color: #fff; display: grid; place-items: center; font: 700 15px Montserrat, sans-serif; }
  .steps h3 { margin-bottom: 6px; } .steps p { margin: 0; color: var(--muted); }
  .alt { background: #fff; border-top: 1px solid var(--line); }
  .two { display: grid; grid-template-columns: 1.4fr 1fr; gap: 40px; align-items: start; }
  @media (max-width: 820px) { .two { grid-template-columns: 1fr; } }
  .docs { padding-left: 20px; } .docs li { margin: 8px 0; } .docs li::marker { color: var(--red); }
  .note { color: var(--muted); font-size: 15px; }
  .side hr { border: 0; border-top: 1px solid var(--line); margin: 18px 0; }
  .side p { margin: 8px 0; }
</style>
