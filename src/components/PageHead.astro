---
import { t, url, sectionOf, type Lang } from '../i18n';
interface Props { lang: Lang; title: string; eyebrow?: string; path: string }
const { lang, title, eyebrow, path } = Astro.props;
const d = t[lang];
const cur = path.replace(/^\//, '');
const section = sectionOf(cur);
---
<div class="page-head">
  <div class="wrap">
    <div class="eyebrow">{eyebrow ?? (section ? d.nav[section.key] : d.short)}</div>
    <h1>{title}</h1>
    {section && (
      <nav class="tabs" aria-label={d.sectionNav}>
        {section.children.map((c) => <a href={url(`/${lang}/${c.path}`)} class={c.path === cur ? 'on' : ''} aria-current={c.path === cur ? 'page' : undefined}>{d.nav[c.key]}</a>)}
      </nav>
    )}
  </div>
</div>
<style>
  .tabs { display: flex; flex-wrap: wrap; gap: 4px 28px; margin-top: 36px; border-bottom: 1px solid #333; }
  .tabs a { color: #d6d6d6; text-decoration: none; padding: 12px 0; font-size: 15.5px; border-bottom: 3px solid transparent; margin-bottom: -1px; }
  .tabs a:hover { color: #fff; border-bottom-color: #555; }
  .tabs a.on { color: #fff; border-bottom-color: var(--gold); font-weight: 600; }
</style>
