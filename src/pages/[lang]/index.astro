---
import Base from '../../layouts/Base.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import { getCollection } from 'astro:content';
import { t, url, fileUrl, fmtDate, langs, type Lang } from '../../i18n';
import home from '../../data/home.json';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const k = (o: any, f: string) => (lang === 'kg' && o[`${f}_kg`]) || o[`${f}_ru`] || '';
const H: any = home;

const news = (await getCollection('news', (n) => n.data.lang === lang && !n.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 9);
const teachers = (await getCollection('teachers')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const L = {
  ru: { kicker: 'Высшее образование · город Манас', mission: 'Миссия', missionLink: 'Подробнее об университете',
    acad: 'Программы', acadT: 'Академические программы', find: 'Найти программу', levelsLabel: 'Направления подготовки', go: 'Перейти к программе', focus: 'Ключевые дисциплины',
    news: 'Новости', newsT: 'Последние новости', allNews: 'Все новости', prev: 'Предыдущие', next: 'Следующие', newsEmpty: 'Здесь появятся новости университета',
    nlT: 'Будьте в курсе жизни университета', nlP: 'Новости, объявления приёмной комиссии и события — раз в месяц на вашу почту.', nlPlh: 'Ваш email', nlBtn: 'Подписаться', nlAlt: 'Следите за новостями и объявлениями университета на сайте.', nlAltBtn: 'Открыть новости',
    life: 'Жизнь университета', facMini: 'Преподаватели', facEmpty: 'Здесь появятся преподаватели',
    alumni: 'Выпускники', alumniT: 'Истории выпускников', classOf: 'выпуск',
    ctaT: 'Готовы сделать следующий шаг в карьере?', ctaP: 'Узнайте о порядке поступления или задайте вопрос приёмной комиссии — мы поможем с выбором программы.',
    pause: 'Пауза видео', play: 'Воспроизвести видео' },
  kg: { kicker: 'Жогорку билим · Манас шаары', mission: 'Миссия', missionLink: 'Университет жөнүндө кененирээк',
    acad: 'Программалар', acadT: 'Академиялык программалар', find: 'Программа табуу', levelsLabel: 'Даярдоо багыттары', go: 'Программага өтүү', focus: 'Негизги дисциплиналар',
    news: 'Жаңылыктар', newsT: 'Акыркы жаңылыктар', allNews: 'Бардык жаңылыктар', prev: 'Мурунку', next: 'Кийинки', newsEmpty: 'Бул жерде университеттин жаңылыктары чыгат',
    nlT: 'Университеттин жашоосунан кабардар болуңуз', nlP: 'Жаңылыктар, кабыл алуу комиссиясынын кулактандыруулары жана окуялар — айына бир жолу почтаңызга.', nlPlh: 'Сиздин email', nlBtn: 'Жазылуу', nlAlt: 'Университеттин жаңылыктарын жана кулактандырууларын сайттан көрүп туруңуз.', nlAltBtn: 'Жаңылыктарды ачуу',
    life: 'Университеттин жашоосу', facMini: 'Окутуучулар', facEmpty: 'Бул жерде окутуучулар чыгат',
    alumni: 'Бүтүрүүчүлөр', alumniT: 'Бүтүрүүчүлөрдүн окуялары', classOf: 'бүтүрүү',
    ctaT: 'Карьераңыздагы кийинки кадамга даярсызбы?', ctaP: 'Тапшыруу тартиби жөнүндө билиңиз же кабыл алуу комиссиясына суроо бериңиз — программа тандоого жардам беребиз.',
    pause: 'Видеону токтотуу', play: 'Видеону ойнотуу' },
}[lang];
const levels = H.levels as any[];
const al = H.alumni;
---
<Base lang={lang} path="/">
  <!-- Блок 2. Герой -->
  <section class="hero on-dark" aria-labelledby="hero-t">
    <div class="hero-media">
      {H.hero_video ? (
        <video class="hero-video" src={fileUrl(H.hero_video)} poster={H.hero_image ? fileUrl(H.hero_image) : undefined} muted loop playsinline preload="metadata" aria-hidden="true"></video>
      ) : H.hero_image ? (
        <img src={fileUrl(H.hero_image)} alt="" fetchpriority="high" />
      ) : (
        <ImageSlot lang={lang} ratio="auto" size="1920 × 1080" dark corner class="hero-slot" />
      )}
    </div>
    <div class="wrap hero-in">
      <p class="eyebrow">{L.kicker}</p>
      <h1 id="hero-t">{d.name}</h1>
      <p class="hero-sub">{k(H, 'subtitle')}</p>
      <div class="actions">
        <a class="btn btn-gold" href={url(`/${lang}/admission/`)}>{d.applyNow}</a>
        <a class="btn btn-line-light" href={url(`/${lang}/contacts/`)}>{d.requestInfo}</a>
      </div>
    </div>
    {H.hero_video && (
      <button type="button" class="vid-toggle" aria-pressed="false" data-pause={L.pause} data-play={L.play} aria-label={L.pause}>
        <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="6" y="5" width="4" height="14" fill="currentColor"/><rect x="14" y="5" width="4" height="14" fill="currentColor"/></svg>
        <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"/></svg>
      </button>
    )}
  </section>

  <!-- Блок 3. Миссия и показатели -->
  <section class="mission" aria-labelledby="mis-t">
    <div class="wrap mis-grid">
      <div class="mis-text">
        <p class="eyebrow">{L.mission}</p>
        <h2 id="mis-t">{k(H, 'mission_title')}</h2>
        <p class="lead">{k(H, 'mission')}</p>
        <a class="link-arrow" href={url(`/${lang}/about/`)}>{L.missionLink}</a>
      </div>
      <ul class="stats">
        {H.stats.map((s: any) => <li><b>{s.value}</b><span>{k(s, 'label')}</span></li>)}
      </ul>
    </div>
  </section>

  <!-- Блок 4. Каталог программ с вкладками -->
  <section class="academics alt-bg" aria-labelledby="acad-t">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">{L.acad}</p>
          <h2 id="acad-t">{L.acadT}</h2>
          <p class="lead">{k(H, 'academics_text')}</p>
        </div>
        <a class="btn btn-line" href={url(`/${lang}/programs/`)}>{L.find}</a>
      </div>
      <div class="tabs" role="tablist" aria-label={L.levelsLabel}>
        {levels.map((lv, i) => (
          <button type="button" role="tab" id={`tab-${i}`} aria-controls={`panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{k(lv, 'tab')}</button>
        ))}
      </div>
      {levels.map((lv, i) => (
        <div class="panel" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} hidden={i !== 0}>
          <div class="panel-img"><ImageSlot src={lv.image} lang={lang} ratio="4 / 3" /></div>
          <div class="panel-txt">
            <h3>{k(lv, 'title')}</h3>
            <p>{k(lv, 'text')}</p>
            {k(lv, 'points') && (
              <>
                <p class="label">{L.focus}</p>
                <ul class="points">{k(lv, 'points').split(';').map((x: string) => x.trim()).filter(Boolean).map((x: string) => <li>{x}</li>)}</ul>
              </>
            )}
            <a class="btn btn-gold" href={url(`/${lang}${lv.link}`)}>{L.go}</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Блок 5. Новости и подписка -->
  <section class="news" aria-labelledby="news-t">
    <div class="wrap">
      <div class="sec-head">
        <div><p class="eyebrow">{L.news}</p><h2 id="news-t">{L.newsT}</h2></div>
        <div class="ctrl">
          <button type="button" class="arrow" data-step="-1" aria-label={L.prev}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
          <button type="button" class="arrow" data-step="1" aria-label={L.next}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
          <a class="link-arrow" href={url(`/${lang}/news/`)}>{L.allNews}</a>
        </div>
      </div>
      <ul class="news-grid" id="news-grid" aria-live="polite">
        {news.length ? news.map((n, i) => (
          <li class="ncard" data-i={i} hidden={i > 2}>
            <a href={url(`/${lang}/news/${n.id}/`)}>
              <span class="zoom"><ImageSlot src={n.data.image} lang={lang} ratio="16 / 9" size="1280 × 720" /></span>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmtDate(n.data.date, lang)}</time>
              <h3>{n.data.title}</h3>
            </a>
          </li>
        )) : [0, 1, 2].map(() => (
          <li class="ncard ghost"><ImageSlot lang={lang} ratio="16 / 9" size="1280 × 720" /><p>{L.newsEmpty}</p></li>
        ))}
      </ul>

      <div class="newsletter on-dark">
        <div>
          <h3>{L.nlT}</h3>
          <p>{H.newsletter_action ? L.nlP : L.nlAlt}</p>
        </div>
        {H.newsletter_action ? (
          <form class="nl-form" action={H.newsletter_action} method="post" target="_blank">
            <label for="nl-email" class="sr-only">{L.nlPlh}</label>
            <input id="nl-email" type="email" name={H.newsletter_field || 'email'} placeholder={L.nlPlh} autocomplete="email" required />
            <button class="btn btn-gold" type="submit">{L.nlBtn}</button>
          </form>
        ) : (
          <a class="btn btn-gold" href={url(`/${lang}/news/announcements/`)}>{L.nlAltBtn}</a>
        )}
      </div>
    </div>
  </section>

  <!-- Блок 6. Тематические витрины -->
  <section class="showcases alt-bg" aria-label={L.life}>
    <div class="wrap">
      {H.showcases.map((f: any, i: number) => (
        <article class={`show ${i % 2 ? 'rev' : ''}`}>
          <a class="show-img zoom" href={url(`/${lang}${f.link}`)} tabindex="-1" aria-hidden="true"><ImageSlot src={f.image} lang={lang} ratio="4 / 3" /></a>
          <div class="show-txt">
            <p class="eyebrow">{L.life}</p>
            <h2>{k(f, 'title')}</h2>
            <p class="lead">{k(f, 'text')}</p>
            <a class="link-arrow" href={url(`/${lang}${f.link}`)}>{k(f, 'button')}</a>
            {i === H.showcases.length - 1 && (
              <ul class="fac-mini" aria-label={L.facMini}>
                {teachers.length ? teachers.map((p) => (
                  <li>
                    <span class="fm-ph"><ImageSlot src={p.data.photo} lang={lang} ratio="1 / 1" round alt={p.data.name} /></span>
                    <span><b>{p.data.name}</b><small>{(lang === 'kg' && p.data.disciplines_kg) || p.data.disciplines_ru || (lang === 'kg' && p.data.role_kg) || p.data.role_ru}</small></span>
                  </li>
                )) : [0, 1, 2].map(() => (
                  <li class="ghost"><span class="fm-ph"><ImageSlot lang={lang} ratio="1 / 1" round /></span><span><small>{L.facEmpty}</small></span></li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Блок 7. Выпускники -->
  <section class="alumni" aria-labelledby="al-t">
    <div class="wrap al-grid">
      <div class="al-photo"><ImageSlot src={al.photo} lang={lang} ratio="4 / 5" size="800 × 1000" alt={al.name} /></div>
      <figure>
        <p class="eyebrow" id="al-t">{L.alumniT}</p>
        <blockquote>«{k(al, 'quote')}»</blockquote>
        <figcaption><b>{al.name}</b><span>{k(al, 'program')}{al.year ? `, ${L.classOf} ${al.year}` : ''}</span></figcaption>
      </figure>
    </div>
  </section>

  <!-- Блок 8. Финальный призыв -->
  <section class="final on-dark" aria-labelledby="cta-t">
    <div class="wrap final-in">
      <h2 id="cta-t">{L.ctaT}</h2>
      <p>{L.ctaP}</p>
      <div class="actions">
        <a class="btn btn-gold" href={url(`/${lang}/admission/`)}>{d.requestInfo}</a>
        <a class="btn btn-line-light" href={url(`/${lang}/contacts/`)}>{lang === 'kg' ? 'Биз менен байланышуу' : 'Связаться с нами'}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // вкладки программ (WAI-ARIA Tabs)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role=tab]')];
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
      if (n === null) return;
      e.preventDefault(); const nt = tabs[(n + tabs.length) % tabs.length]; select(nt); nt.focus();
    });
  });

  // новости: листание по 3
  const cards = [...document.querySelectorAll<HTMLElement>('.ncard[data-i]')];
  let page = 0;
  const pages = Math.max(1, Math.ceil(cards.length / 3));
  const arrows = [...document.querySelectorAll<HTMLButtonElement>('.arrow')];
  const render = () => {
    cards.forEach((c) => { const i = Number(c.dataset.i); c.hidden = i < page * 3 || i >= page * 3 + 3; });
    arrows.forEach((a) => { a.disabled = pages < 2 || (Number(a.dataset.step) < 0 ? page === 0 : page === pages - 1); });
  };
  arrows.forEach((a) => a.addEventListener('click', () => { page = Math.min(pages - 1, Math.max(0, page + Number(a.dataset.step))); render(); }));
  render();

  // видео: автозапуск только без «уменьшить движение», кнопка паузы
  const v = document.querySelector<HTMLVideoElement>('.hero-video');
  const vb = document.querySelector<HTMLButtonElement>('.vid-toggle');
  if (v && vb) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const set = (playing: boolean) => { vb.setAttribute('aria-pressed', String(!playing)); vb.setAttribute('aria-label', playing ? vb.dataset.pause! : vb.dataset.play!); vb.classList.toggle('paused', !playing); };
    if (!reduce) v.play().then(() => set(true)).catch(() => set(false)); else set(false);
    vb.addEventListener('click', () => { if (v.paused) { v.play(); set(true); } else { v.pause(); set(false); } });
  }
</script>

<style>
  .alt-bg { background: var(--bg-alt); }
  .actions { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 36px; }
  .sec-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 40px; }
  .sec-head h2 { margin-bottom: .3em; }
  .sec-head .lead { margin: 0; }

  /* герой */
  .hero { position: relative; min-height: min(82vh, 800px); display: flex; align-items: flex-end; padding: 0; color: #fff; background: var(--dark); overflow: hidden; }
  .hero-media { position: absolute; inset: 0; }
  .hero-media img, .hero-video, .hero-media :global(.hero-slot) { width: 100%; height: 100%; object-fit: cover; border: 0; display: block; }
  .hero-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,10,10,.88) 0%, rgba(10,10,10,.6) 50%, rgba(10,10,10,.2) 100%), linear-gradient(0deg, rgba(10,10,10,.6), transparent 50%); }
  .hero-in { position: relative; z-index: 1; padding-block: 140px 96px; width: 100%; }
  .hero .eyebrow { color: var(--gold); } .hero .eyebrow::before { background: var(--gold); }
  .hero h1 { color: #fff; font-size: clamp(40px, 6vw, 64px); max-width: 15em; margin-bottom: 22px; }
  .hero-sub { font-size: clamp(18px, 1.8vw, 21px); color: #e6e6e6; max-width: 46ch; margin: 0; }
  .vid-toggle { position: absolute; right: 24px; bottom: 24px; z-index: 2; width: 48px; height: 48px; display: grid; place-items: center; background: rgba(0,0,0,.55); color: #fff; border: 1px solid rgba(255,255,255,.5); cursor: pointer; }
  .vid-toggle .i-play, .vid-toggle.paused .i-pause { display: none; } .vid-toggle.paused .i-play { display: block; }

  /* миссия и цифры */
  .mis-grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: center; }
  .mis-text { grid-column: 1 / span 7; }
  .mis-text h2 { max-width: 18ch; }
  .mis-text .lead { margin: 0 0 28px; }
  .stats { grid-column: 9 / span 4; list-style: none; margin: 0; padding: 0; display: grid; gap: 0; }
  .stats li { padding: 26px 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; }
  .stats li:last-child { border-bottom: 1px solid var(--line); }
  .stats b { font: 500 clamp(48px, 5vw, 64px)/1 var(--cond); color: var(--dark); min-width: 2.6ch; }
  .stats b::after { content: ''; display: block; width: 100%; height: 3px; background: var(--gold-line); margin-top: 10px; }
  .stats span { color: var(--muted); font-size: 16px; }
  @media (max-width: 960px) { .mis-text, .stats { grid-column: 1 / -1; } .stats { grid-template-columns: repeat(3, 1fr); gap: 20px; } .stats li { grid-template-columns: 1fr; border: 0; border-top: 1px solid var(--line); } .stats li:last-child { border-bottom: 0; } }
  @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } }

  /* вкладки программ */
  .tabs { display: flex; gap: 4px 32px; flex-wrap: wrap; border-bottom: 1px solid var(--line); margin-bottom: 40px; }
  [role=tab] { background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -1px; padding: 14px 0; font: 600 17px var(--sans); color: var(--muted); cursor: pointer; transition: color .2s, border-color .2s; }
  [role=tab]:hover { color: var(--dark); }
  [role=tab][aria-selected=true] { color: var(--dark); border-bottom-color: var(--gold-line); }
  .panel { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: center; }
  .panel[hidden] { display: none; }
  .panel-img { grid-column: 1 / span 6; }
  .panel-txt { grid-column: 8 / span 5; }
  .panel-txt h3 { font-family: var(--serif); font-weight: 700; font-size: clamp(24px, 2.4vw, 30px); }
  .panel-txt > p:not(.label) { color: var(--muted); }
  .points { list-style: none; padding: 0; margin: 0 0 30px; display: grid; gap: 10px; }
  .points li { padding-left: 22px; position: relative; }
  .points li::before { content: ''; position: absolute; left: 0; top: .7em; width: 10px; height: 2px; background: var(--gold-line); }
  @media (max-width: 900px) { .panel-img, .panel-txt { grid-column: 1 / -1; } }

  /* новости */
  .ctrl { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .arrow { width: 48px; height: 48px; border: 1.5px solid var(--dark); background: #fff; color: var(--dark); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s; }
  .arrow:hover:not(:disabled) { background: var(--dark); color: #fff; }
  .arrow:disabled { opacity: .35; cursor: default; }
  .ctrl .link-arrow { margin-left: 12px; }
  .news-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  @media (max-width: 900px) { .news-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .news-grid { grid-template-columns: 1fr; } }
  .ncard[hidden] { display: none; }
  .ncard a { display: block; text-decoration: none; color: inherit; }
  .ncard time { display: block; margin-top: 18px; font: 500 14px var(--cond); letter-spacing: .08em; text-transform: uppercase; color: var(--gold-text); }
  .ncard h3 { margin-top: 8px; font-size: 21px; }
  .ncard a:hover h3 { text-decoration: underline; text-decoration-color: var(--gold-line); text-underline-offset: 4px; }
  .ncard.ghost p { color: var(--muted); margin-top: 16px; }
  .newsletter { margin-top: 64px; background: var(--dark); color: #fff; padding: 40px 44px; display: grid; grid-template-columns: 1fr auto; gap: 24px 48px; align-items: center; border-left: 4px solid var(--gold); }
  .newsletter h3 { color: #fff; font-family: var(--serif); font-weight: 700; margin-bottom: 6px; }
  .newsletter p { color: var(--on-dark-2); margin: 0; }
  .nl-form { display: flex; gap: 10px; flex-wrap: wrap; }
  .nl-form input { min-height: 48px; min-width: 260px; padding: 12px 16px; border: 1px solid #555; background: #1f1f1f; color: #fff; font: 400 16px var(--sans); }
  .nl-form input:focus { outline: 2px solid var(--gold); outline-offset: 2px; }
  @media (max-width: 800px) { .newsletter { grid-template-columns: 1fr; padding: 32px 24px; } .nl-form input { min-width: 0; flex: 1; } }

  /* витрины */
  .show { display: grid; grid-template-columns: repeat(12, 1fr); gap: 24px; align-items: center; padding: 56px 0; }
  .show + .show { border-top: 1px solid var(--line); }
  .show-img { grid-column: 1 / span 6; text-decoration: none; }
