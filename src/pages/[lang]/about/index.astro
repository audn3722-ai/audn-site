---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import { t, langs, type Lang } from '../../../i18n';
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const d = t[lang];
const L = {
  ru: {
    intro: 'Азиатский университет дружбы народов — высшее учебное заведение в городе Манас, которое готовит юристов и педагогов для Кыргызстана и региона.',
    p: ['Университет зарегистрирован 19 мая 2021 года. Наша задача — дать студентам глубокие фундаментальные знания и практические навыки, которые нужны с первого рабочего дня.',
        'Название университета отражает его ценности: уважение к людям разных народов и культур, открытость и сотрудничество.'],
    facts: [['2021', 'год основания'], ['2', 'направления подготовки']],
  },
  kg: {
    intro: 'Азия элдер достугу университети — Манас шаарындагы жогорку окуу жайы, Кыргызстан жана аймак үчүн юристтерди жана педагогдорду даярдайт.',
    p: ['Университет 2021-жылдын 19-майында катталган. Биздин максат — студенттерге терең фундаменталдык билим жана биринчи жумуш күнүнөн тартып керек болгон практикалык көндүмдөрдү берүү.',
        'Университеттин аталышы анын баалуулуктарын чагылдырат: ар түрдүү элдердин жана маданияттардын өкүлдөрүн урматтоо, ачыктык жана кызматташтык.'],
    facts: [['2021', 'негизделген жылы'], ['2', 'даярдоо багыты']],
  },
}[lang];
---
<Base lang={lang} title={d.nav.about} path="/about/">
  <PageHead lang={lang} title={d.nav.about} path="/about/" />
  <section>
    <div class="wrap about">
      <div class="prose">
        <p class="lead">{L.intro}</p>
        {L.p.map((x) => <p>{x}</p>)}
        <p class="small">{d.fullName}</p>
      </div>
      <div class="facts">
        {L.facts.map(([n, l]) => <div class="fact"><b>{n}</b><span>{l}</span></div>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .about { display: grid; grid-template-columns: 1.6fr 1fr; gap: 48px; align-items: start; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } }
  .small { font-size: 14px; color: var(--muted); }
  .facts { display: grid; gap: 14px; }
  .fact { background: var(--navy); color: #fff; border-radius: var(--radius); padding: 22px 26px; display: flex; align-items: baseline; gap: 16px; }
  .fact b { font: 700 40px var(--serif); color: #fff; } .fact span { color: var(--on-dark-2); }
</style>
